# Optional: when omitted, the app reads the synthetic JSON fixtures locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Required for model-based triage. Without a key, the app uses its transparent
# local rules baseline and labels that run as heuristic mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

PORT=4317
