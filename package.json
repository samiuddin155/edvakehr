{
  "name": "edvak-forge-front-desk-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/api.ts",
    "dev:web": "vite --host 127.0.0.1",
    "mcp": "tsx server/mcp-stdio.ts",
    "evaluate": "tsx server/evaluate-cli.ts",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/api.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tabler/icons-react": "3.49.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "motion": "^14.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
